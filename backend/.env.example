# PostgreSQL connection string (Neon, Supabase, Render Postgres, or local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ratehub"

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Frontend URL(s) allowed to call this API (comma-separated, no trailing slash)
CORS_ORIGIN="http://localhost:5173"

PORT=5000
